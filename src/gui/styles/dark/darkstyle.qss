DatabaseWidget:!active,
DatabaseWidget #groupView:!active, DatabaseWidget #tagView:!active,
EntryPreviewWidget *:!active[blendIn="true"] {
    background-color: #404042;
}

DatabaseWidget:disabled,
DatabaseWidget #groupView:disabled, DatabaseWidget #tagView:disabled,
EntryPreviewWidget *:disabled[blendIn="true"] {
    background-color: #424242;
}

QMenu {
    border: 1px solid #56565A;
}

QMenu::separator {
    height: 1px;
    background-color: #56565A;
}

QPushButton:!default:hover {
    /* Using slightly darker shade from palette(button) */
    background: #252528;
}

QPushButton:default:hover, QPushButton:checked:hover {
    /* Using slightly lighter shade from palette(highlight) */
    background: #2E582E;
}

QToolTip {
    color: #BFBFBF;
    background-color: #2D532D;
}

QGroupBox {
    background-color: palette(light);
}

/* Keystone: selected Warm Minimal design. */
QMainWindow, QDialog { background: #222320; }
QWidget#vaultSidebar, QWidget#vaultGroups, QWidget#tagWidget { background: #292A26; border: none; }
QWidget#keystoneEntryPane, QWidget#previewWidget { background: #222320; }
QLabel#keystoneBrand { font-size: 21px; font-weight: 400; padding: 8px 14px; color: #E9E9E4; }
QPushButton[navigation="true"] { text-align: left; border: none; border-radius: 8px; background: transparent; color: #E9E9E4; padding: 12px 16px; font-size: 15px; }
QPushButton[navigation="true"]:checked { background: #42483A; }
QPushButton[navigation="true"]:hover { background: #34382F; }
QToolButton#keystoneVaultButton { border: none; border-top: 1px solid #3C3E37; background: transparent; padding: 20px 8px 8px 8px; text-align: left; color: #E9E9E4; font-size: 13px; }
QLabel#keystoneListTitle { font-size: 16px; font-weight: 600; padding: 8px 10px 0px 10px; color: #E9E9E4; }
QTreeView#entryView { background: #222320; border: none; padding: 0px; color: #E9E9E4; outline: none; }
QTreeView#entryView::item { height: 68px; padding: 0px; border: none; border-radius: 8px; }
QTreeView#entryView::item:selected { background: #42483A; color: #E9E9E4; }
QTreeView#entryView::item:hover { background: #34382F; }
QTreeView#entryView::item:focus { border: none; }
QWidget#entryGeneralWidget, QWidget#entryGeneralWidget QWidget { background: transparent; }
QWidget#keystoneCredentialFields { border: 1px solid #3C3E37; border-radius: 8px; }
QWidget#keystoneCredentialFields QWidget { border: none; }
QWidget#previewWidget QLabel, QWidget#previewWidget QLineEdit, QWidget#previewWidget QTextEdit { color: #E9E9E4; font-size: 14px; }
QWidget#previewWidget QLabel#entryTitleLabel { font-size: 30px; font-weight: 600; padding: 18px 0px 6px 0px; }
QWidget#previewWidget QLabel#entryIcon { font-size: 60px; font-weight: 500; color: #ACB9A0; }
QWidget#previewWidget QLabel#keystoneDomain { font-size: 16px; color: #9A9D94; }
QWidget#previewWidget QLabel#keystoneEmptyTitle { font-size: 24px; font-weight: 600; padding-bottom: 12px; }
QWidget#entryGeneralWidget QLineEdit { border: none; padding: 0px; }
QWidget#entryGeneralWidget QToolButton { border: none; background: transparent; border-radius: 5px; padding: 4px; }
QWidget#entryGeneralWidget QToolButton:hover { background: #34382F; }
QWidget#entryGeneralWidget QLabel#entryUsernameTitleLabel, QWidget#entryGeneralWidget QLabel#entryPasswordTitleLabel,
QWidget#entryGeneralWidget QLabel#entryUrlTitleLabel, QWidget#entryGeneralWidget QLabel#entryNotesTitleLabel { color: #9A9D94; }
QToolButton#keystoneAddEntry, QToolButton#keystoneMore { border: 1px solid #3C3E37; border-radius: 6px; padding: 7px; background: #222320; }
QToolButton#keystoneMore { border: none; }
QLineEdit, QComboBox, QSpinBox { border: 1px solid #3C3E37; border-radius: 7px; padding: 8px; background: #222320; color: #E9E9E4; }
QLineEdit:focus { border: 1px solid #ACB9A0; }
QLineEdit#searchEdit { font-size: 14px; }
QPushButton { border: 1px solid #3C3E37; border-radius: 7px; padding: 8px 16px; background: #222320; color: #E9E9E4; }
QPushButton:hover { background: #34382F; }
QPushButton:default { background: #ACB9A0; color: #222320; }
QPushButton:disabled { color: #9A9D94; }
QTabWidget::pane { border: none; }
QTabBar::tab { padding: 8px 12px; border: none; border-radius: 6px; }
QTabBar::tab:selected { background: #42483A; }
QSplitter::handle { background: #3C3E37; width: 1px; height: 1px; }
QTreeView#groupView, QListView#tagView { background: #292A26; color: #E9E9E4; border: none; }
QTreeView#groupView::item, QListView#tagView::item { padding: 5px; border-radius: 5px; }
QTreeView#groupView::item:selected, QListView#tagView::item:selected { background: #42483A; color: #E9E9E4; }

QWidget#entryGeneralWidget QLabel#entryUsernameTitleLabel, QWidget#entryGeneralWidget QLabel#entryPasswordTitleLabel,
QWidget#entryGeneralWidget QLabel#entryUrlTitleLabel, QWidget#entryGeneralWidget QLabel#entryNotesTitleLabel { font-weight: normal; }
QToolButton#keystoneMore::menu-indicator { image: none; }
QToolButton#keystoneVaultButton::menu-indicator { image: none; }
