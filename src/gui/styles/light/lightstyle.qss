DatabaseWidget:!active,
DatabaseWidget #groupView:!active, DatabaseWidget #tagView:!active,
EntryPreviewWidget *:!active[blendIn="true"] {
    background-color: #FCFCFC;
}

DatabaseWidget:disabled,
DatabaseWidget #groupView:disabled, DatabaseWidget #tagView:disabled,
EntryPreviewWidget *:disabled[blendIn="true"] {
    background-color: #EDEDED;
}

QPushButton:default:hover, QPushButton:checked:hover {
    /* Using slightly lighter shade from palette(highlight) */
    background: #568821;
}

QToolTip {
    color: #F9F9F9;
    background-color: #4D7F1A;
}

QGroupBox::title {
    color: #4B7B19;
}

/* Keystone: selected Warm Minimal design. */
QMainWindow, QDialog { background: #FCFBFA; }
QWidget#vaultSidebar, QWidget#vaultGroups, QWidget#tagWidget { background: #F3F2EF; border: none; }
QWidget#keystoneEntryPane, QWidget#previewWidget { background: #FCFBFA; }
QLabel#keystoneBrand { font-size: 21px; font-weight: 400; padding: 8px 14px; color: #272925; }
QPushButton[navigation="true"] { text-align: left; border: none; border-radius: 8px; background: transparent; color: #272925; padding: 12px 16px; font-size: 15px; }
QPushButton[navigation="true"]:checked { background: #DDDFD7; }
QPushButton[navigation="true"]:hover { background: #ECEDE7; }
QToolButton#keystoneVaultButton { border: none; border-top: 1px solid #E5E3DE; background: transparent; padding: 20px 8px 8px 8px; text-align: left; color: #272925; font-size: 13px; }
QLabel#keystoneListTitle { font-size: 16px; font-weight: 600; padding: 8px 10px 0px 10px; color: #272925; }
QTreeView#entryView { background: #FCFBFA; border: none; padding: 0px; color: #272925; outline: none; }
QTreeView#entryView::item { height: 68px; padding: 0px; border: none; border-radius: 8px; }
QTreeView#entryView::item:selected { background: #DDDFD7; color: #272925; }
QTreeView#entryView::item:hover { background: #ECEDE7; }
QTreeView#entryView::item:focus { border: none; }
QWidget#entryGeneralWidget, QWidget#entryGeneralWidget QWidget { background: transparent; }
QWidget#keystoneCredentialFields { border: 1px solid #E5E3DE; border-radius: 8px; }
QWidget#keystoneCredentialFields QWidget { border: none; }
QWidget#previewWidget QLabel, QWidget#previewWidget QLineEdit, QWidget#previewWidget QTextEdit { color: #272925; font-size: 14px; }
QWidget#previewWidget QLabel#entryTitleLabel { font-size: 30px; font-weight: 600; padding: 18px 0px 6px 0px; }
QWidget#previewWidget QLabel#entryIcon { font-size: 60px; font-weight: 500; color: #596B51; }
QWidget#previewWidget QLabel#keystoneDomain { font-size: 16px; color: #868783; }
QWidget#previewWidget QLabel#keystoneEmptyTitle { font-size: 24px; font-weight: 600; padding-bottom: 12px; }
QWidget#entryGeneralWidget QLineEdit { border: none; padding: 0px; }
QWidget#entryGeneralWidget QToolButton { border: none; background: transparent; border-radius: 5px; padding: 4px; }
QWidget#entryGeneralWidget QToolButton:hover { background: #ECEDE7; }
QWidget#entryGeneralWidget QLabel#entryUsernameTitleLabel, QWidget#entryGeneralWidget QLabel#entryPasswordTitleLabel,
QWidget#entryGeneralWidget QLabel#entryUrlTitleLabel, QWidget#entryGeneralWidget QLabel#entryNotesTitleLabel { color: #868783; }
QToolButton#keystoneAddEntry, QToolButton#keystoneMore { border: 1px solid #E5E3DE; border-radius: 6px; padding: 7px; background: #FCFBFA; }
QToolButton#keystoneMore { border: none; }
QLineEdit, QComboBox, QSpinBox { border: 1px solid #E5E3DE; border-radius: 7px; padding: 8px; background: #FCFBFA; color: #272925; }
QLineEdit:focus { border: 1px solid #596B51; }
QLineEdit#searchEdit { font-size: 14px; }
QPushButton { border: 1px solid #E5E3DE; border-radius: 7px; padding: 8px 16px; background: #FCFBFA; color: #272925; }
QPushButton:hover { background: #ECEDE7; }
QPushButton:default { background: #596B51; color: #FCFBFA; }
QPushButton:disabled { color: #868783; }
QTabWidget::pane { border: none; }
QTabBar::tab { padding: 8px 12px; border: none; border-radius: 6px; }
QTabBar::tab:selected { background: #DDDFD7; }
QSplitter::handle { background: #E5E3DE; width: 1px; height: 1px; }
QTreeView#groupView, QListView#tagView { background: #F3F2EF; color: #272925; border: none; }
QTreeView#groupView::item, QListView#tagView::item { padding: 5px; border-radius: 5px; }
QTreeView#groupView::item:selected, QListView#tagView::item:selected { background: #DDDFD7; color: #272925; }

QWidget#entryGeneralWidget QLabel#entryUsernameTitleLabel, QWidget#entryGeneralWidget QLabel#entryPasswordTitleLabel,
QWidget#entryGeneralWidget QLabel#entryUrlTitleLabel, QWidget#entryGeneralWidget QLabel#entryNotesTitleLabel { font-weight: normal; }
QToolButton#keystoneMore::menu-indicator { image: none; }
QToolButton#keystoneVaultButton::menu-indicator { image: none; }
