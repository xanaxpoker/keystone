DatabaseWidget:!active,
DatabaseWidget #groupView:!active, DatabaseWidget #tagView:!active,
EntryPreviewWidget *:!active[blendIn="true"] {
    background-color: #FCFCFC;
}

DatabaseWidget:disabled,
DatabaseWidget #groupView:disabled, DatabaseWidget #tagView:disabled,
EntryPreviewWidget *:disabled[blendIn="true"] {
    background-color: #EDEDED;
}

QPushButton:default:hover, QPushButton:checked:hover {
    /* Using slightly lighter shade from palette(highlight) */
    background: #568821;
}

QToolTip {
    color: #F9F9F9;
    background-color: #4D7F1A;
}

QGroupBox::title {
    color: #4B7B19;
}

/* Keystone interface. Keep security-sensitive widgets and handlers upstream. */
QMainWindow, QDialog { background: #F7F8FA; }
QWidget#vaultSidebar, QWidget#tagWidget, QTreeView#groupView, QTreeView#tagView { background: #EDEFF3; border: none; }
QTreeView#groupView, QTreeView#tagView { padding: 12px 6px; color: #1D2433; }
QTreeView#groupView::item, QTreeView#tagView::item { min-height: 32px; padding: 3px 8px; border-radius: 7px; }
QTreeView#groupView::item:selected, QTreeView#tagView::item:selected { background: #3478F6; color: white; }
QTreeView#entryView { background: #FFFFFF; border: none; padding: 8px; color: #1D2433; }
QTreeView#entryView::item { min-height: 48px; padding: 5px 8px; border-bottom: 1px solid #DCE1E9; }
QTreeView#entryView::item:selected { background: #E6EEFF; color: #1D2433; }
QHeaderView::section { background: #FFFFFF; color: #667085; border: none; border-bottom: 1px solid #DCE1E9; padding: 10px 8px; font-weight: 600; }
QWidget#previewWidget { background: #F7F8FA; }
QWidget#entryGeneralWidget { background: #FFFFFF; border-radius: 12px; }
QLabel#entryTitleLabel { font-size: 23px; font-weight: 600; padding: 12px 0; }
QToolBar { background: #F7F8FA; border: none; border-bottom: 1px solid #DCE1E9; spacing: 6px; padding: 10px; }
QToolBar QToolButton { border-radius: 7px; padding: 6px; }
QToolBar QToolButton:hover { background: #E6EEFF; }
QLineEdit, QComboBox, QSpinBox { border: 1px solid #DCE1E9; border-radius: 7px; padding: 7px; background: #FFFFFF; color: #1D2433; selection-background-color: #3478F6; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border: 1px solid #3478F6; }
QLineEdit:disabled, QComboBox:disabled { color: #667085; background: #EDEFF3; }
QPushButton { border: 1px solid #DCE1E9; border-radius: 8px; padding: 8px 16px; background: #FFFFFF; color: #1D2433; }
QPushButton:hover { background: #E6EEFF; }
QPushButton:default, QPushButton#buttonNewDatabase { background: #3478F6; color: white; border-color: #3478F6; }
QPushButton:disabled { color: #667085; background: #EDEFF3; }
QPushButton:focus { border: 2px solid #3478F6; }
QTabWidget::pane { border: none; }
QTabBar::tab { padding: 9px 14px; margin: 3px; border-radius: 7px; }
QTabBar::tab:selected { background: #FFFFFF; color: #3478F6; }
QSplitter::handle { background: #DCE1E9; width: 1px; height: 1px; }
QStatusBar { background: #F7F8FA; color: #667085; border-top: 1px solid #DCE1E9; }
QLabel#startLabel { color: #667085; font-size: 14px; padding: 12px; }
QLabel#recentLabel { color: #667085; font-size: 11px; font-weight: 600; padding: 10px 0; }
QListWidget#recentListWidget { background: #FFFFFF; border: 1px solid #DCE1E9; border-radius: 10px; padding: 8px; }
QListWidget#recentListWidget::item { padding: 8px; }
